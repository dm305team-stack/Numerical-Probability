# Copia este fichero a  web/.env  y rellena los valores.
# web/.env está en .gitignore y NUNCA debe subirse: el repo es público.

# ── Acceso a la app ───────────────────────────────────────────────────────────
# Clave compartida para entrar. Mínimo 16 caracteres o la app no arranca.
APP_KEY=
# Secreto con el que se firma la cookie de sesión. Si lo cambias, echas a todo
# el mundo. Genera uno con:  python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=

# Modo local: con LOCAL=1 la app no pide clave. EN EL VPS NO SE PONE.
LOCAL=

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Interpreta la petición (barato). Ancla la versión, nunca uses alias ~latest.
OPENROUTER_MODEL=typesafe/jev-router
# Redacta la prosa que acompaña a los boletos.
OPENROUTER_MODELO_PROSA=typesafe/jev-router
# Tope de llamadas de pago al día. Al agotarse, la app sigue con el intérprete
# local: se degrada, no se cae.
TOPE_LLM_DIARIO=300
OPENROUTER_TIMEOUT=20
# Esfuerzo de razonamiento. Los gpt-5 SIN esto devuelven contenido vacío; los
# routers como Jev lo RECHAZAN con un 400 porque eligen ellos. Se omite solo en
# los modelos cuyo identificador lleva "router". Déjalo vacío para no mandarlo
# nunca.
OPENROUTER_ESFUERZO=low

# ── Telegram (el agente que avisa) ────────────────────────────────────────────
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Tu chat id. Escríbele al bot y míralo en:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# ── Despliegue ────────────────────────────────────────────────────────────────
APP_URL=https://glowbychoice.com
# Los sorteos son en hora del este. Un servidor en UTC calcula mal el día.
TZ=America/New_York
